# Public canonical origin. Use the exact approved HTTPS origin for the target environment.
# Netlify previews resolve their origin from Netlify's read-only deployment URL variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for local/private previews. Set true only with the approved HTTPS production domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Digits only, in international format without +. Leave empty to hide WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=212624651236

# Server-only Resend configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Durable production rate limiting through Upstash Redis REST.
# Production submissions fail closed when these values are absent or invalid.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value of at least 16 characters; do not expose it publicly.
CONTACT_RATE_LIMIT_SALT=
